{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=sts_app;User=sts_user;Password=<MYSQL_PASSWORD>;TreatTinyAsBoolean=false;"
  },
  "ExternalApis": {
    "Stt": {
      "BaseUrl": "<STT_API_BASE_URL>",
      "TranscribePath": "/transcribe",
      "DecodingType": "tdt",
      "TimeoutSeconds": 60
    },
    "Tts": {
      "BaseUrl": "<TTS_API_BASE_URL>",
      "SpeakPath": "/speak",
      "Voicepack": "<VOICEPACK_NAME_OR_EMPTY>",
      "Alpha": null,
      "Beta": null,
      "Speed": null,
      "ResponseMimeType": "audio/wav",
      "ResponseFileExtension": ".wav",
      "TimeoutSeconds": 60
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/interactions",
      "ApiKey": "<GEMINI_API_KEY>",
      "ModelName": "<GEMINI_MODEL_NAME>",
      "SystemInstruction": "あなたは音声対話システムのアシスタントです。短く自然な日本語で返答してください。",
      "TimeoutSeconds": 60
    }
  }
}
