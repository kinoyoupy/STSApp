<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="WebRtcVad.NET" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\STSApp.Contracts\STSApp.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    macOSの録音ブリッジは、追加の.NETパッケージではなくmacOS標準のAVFoundationを使います。
    dotnet buildの前にclangで小さなdylibを生成し、Desktopの出力先へ配置します。
    現在の実行環境はmacOSなので、Unix環境でだけ実行します。
  -->
  <Target Name="BuildMacAudioBridge" BeforeTargets="Build" Condition="'$(OS)' == 'Unix'">
    <Exec Command="mkdir -p &quot;$(OutputPath)&quot; &amp;&amp; clang -fobjc-arc -dynamiclib -framework Foundation -framework AVFoundation &quot;$(MSBuildProjectDirectory)/Native/MacContinuousAudioRecorder.m&quot; -o &quot;$(OutputPath)libsts_audio_recorder.dylib&quot;" />
  </Target>
</Project>
